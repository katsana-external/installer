{
    "name": "orchestra/installer",
    "description": "Orchestra Platform Installer",
    "license": "MIT",
    "keywords": [
        "orchestra-platform",
        "orchestral",
        "installer"
    ],
    "authors": [
        {
            "name": "Mior Muhammad Zaki",
            "email": "crynobone@gmail.com",
            "homepage": "https://github.com/crynobone"
        }
    ],
    "autoload": {
        "psr-4": {
            "Orchestra\\Installation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orchestra\\Installation\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": " ^8.0",
        "orchestra/contracts": "^7.0"
    },
    "require-dev": {
        "orchestra/canvas": "^7.0",
        "orchestra/foundation": "7.x",
        "orchestra/testing": "7.0.x-dev"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/katsana-external/testing"
        },
        {
            "type": "vcs",
            "url": "https://github.com/katsana-external/foundation"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "7.0-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
